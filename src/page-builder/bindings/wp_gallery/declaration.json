{
  "id": "wp_gallery",
  "title": "WP Gallery",
  "summary": "Render images attached to a post as a gallery grid",
  "type": "self_rendering",
  "static_safety": "public_request_safe",
  "output_shape": "html",
  "renderer_class": "UncannyPageBuilder\\Infrastructure\\Rendering\\WpSingleValueRenderer",
  "query_attributes": {
    "data-post-id": { "required": false, "default": "0", "cast": "int" },
    "data-count": { "required": false, "default": "10", "cast": "int" },
    "data-size": { "required": false, "default": "medium" }
  },
  "bind_keys": [],
  "meta_bindings": false,
  "tags": ["media", "image", "gallery", "card", "loop", "portfolio"]
}
